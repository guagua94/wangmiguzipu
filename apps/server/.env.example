# === Railway 后端环境变量示例 ===
# 复制为 .env 文件并填入真实值，不要提交真实 .env 到 Git

# PostgreSQL 数据库连接地址（Railway 自动生成）
DATABASE_URL=postgresql://user:password@host:port/database

# JWT 签名密钥（生产环境请用强密码）
JWT_SECRET=your-jwt-secret-key

# 服务端口（Railway 会覆盖此值）
PORT=3001

# PostgreSQL SSL 配置（Railway 内网可设为 false）
DATABASE_SSL=false
